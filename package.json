{
  "name": "dsh-milvus",
  "version": "0.0.0-development",
  "private": true,
  "description": "Milvus for DSH — development package",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "profile-settings.mjs",
    "connection-check.mjs",
    "connection-status.mjs",
    "milvus-transport.mjs",
    "milvus-tools.mjs",
    "session-binding.mjs",
    "client.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/sdk-compatibility.integration.test.mjs",
    "test:integration:connection": "node --test tests/connection-check.integration.test.mjs",
    "test:integration:mutation": "node --test tests/sdk-mutation.integration.test.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@zilliz/milvus2-sdk-node": "3.0.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-settings": "0.1.0-rc.7",
    "@deepseek-ai/schemastery": "3.18.1"
  }
}
